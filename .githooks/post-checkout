#!/bin/sh
[ "$1" = "0000000000000000000000000000000000000000" ] || exit 0
[ -f .worktreeinclude ] || exit 0
main=$(git worktree list --porcelain | sed -n '1s/^worktree //p')
[ -n "$main" ] && [ "$main" != "$(pwd)" ] || exit 0
grep -v '^[[:space:]]*\(#\|$\)' .worktreeinclude | while IFS= read -r entry; do
  path=${entry%/}
  [ -e "$main/$path" ] && [ ! -e "$path" ] || continue
  mkdir -p "$(dirname "$path")"
  cp -R "$main/$path" "$path" && echo "worktree: copied $path"
done
exit 0
